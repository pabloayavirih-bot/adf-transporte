{
	"name": "DF_Silver_Incidentes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DW_Bronze_Incidentes_SQL",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DW_Silver_Incidentes_SQL",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(IncidenteId),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          VehiculoId = trim(VehiculoId),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraInicio = toTimestamp(trim(FechaHoraInicio)),",
				"          FechaHoraFin = toTimestamp(trim(FechaHoraFin)),",
				"          FechaHoraRegistro = toTimestamp(trim(FechaHoraRegistro))) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          SilverId as long,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}